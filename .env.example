# Copy to .env.local. Placeholders only; real values live in Vercel.
# 0 = prelaunch (waitlist), 1 = launch (store URLs below become required)
NEXT_PUBLIC_LAUNCH=0
# 0 = checkout and checkout/return 404 (Pro not open yet), 1 = Pro checkout live
NEXT_PUBLIC_CHECKOUT=0
# 1 = header "For sellers" / "For shoppers" toggle (desktop nav and menu sheet); 0 hides it, /sellers stays reachable
NEXT_PUBLIC_SELLERS_NAV=0
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/gitprice/example
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/gitprice/id0000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.gitprice
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-publishable-key
# Optional, loaded after consent
NEXT_PUBLIC_HEAP_ID=
# Optional Meta / TikTok pixels (public ids); scripts load only after consent Allow
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Server-only Meta Conversions API token (never NEXT_PUBLIC_). Used by /api/send-to-desktop when consent Allow.
META_CAPI_ACCESS_TOKEN=
# Server-only Resend for /api/send-to-desktop (missing → endpoint 503; page still works)
RESEND_API_KEY=
RESEND_FROM=
# Cloudflare Turnstile for /get email form (site key public; secret server-only). When secret is set, posts without a valid token get 403.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST (rate limit + email cooldown for /api/send-to-desktop). Missing → in-memory fallback (fine for local/e2e).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional, Google Tag Manager container; cookieless until Allow (Consent Mode v2)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, public Telegram deals channel (https://t.me/...); unset hides every channel link
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=
