# Copy to .env.local. Placeholders only; real values live in Vercel.
# 0 = prelaunch (waitlist), 1 = launch (store URLs below become required)
NEXT_PUBLIC_LAUNCH=0
# 0 = checkout and checkout/return 404 (Pro not open yet), 1 = Pro checkout live
NEXT_PUBLIC_CHECKOUT=0
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/gitprice/example
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/gitprice/id0000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.example.gitprice
NEXT_PUBLIC_TALLY_FORM_ID=example
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-publishable-key
# Optional, loaded after consent
NEXT_PUBLIC_HEAP_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
